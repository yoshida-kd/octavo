{
  "表 (Table)": {
    "scope": "markdown",
    "prefix": "ptable",
    "body": [
      "**表${1:1}．${2:キャプション}**",
      "",
      "| ${3:変数} | ${4:平均} | ${5:標準偏差} |",
      "|---|---|---|",
      "| ${6:x} | ${7:1.2} | ${8:0.3} |",
      "",
      "*注: ${9:出所や注記}*",
      "$0"
    ],
    "description": "octavo が認識する表のキャプション+マークダウン表"
  },

  "図 (Figure)": {
    "scope": "markdown",
    "prefix": "pfigure",
    "body": [
      "![](figures/${1:fig1_name}.png)",
      "",
      "**図${2:1}．** ${3:説明}",
      "$0"
    ],
    "description": "octavo が認識する図の貼り付け+キャプション"
  },

  "所有格引用 (poscite)": {
    "scope": "markdown",
    "prefix": "pposcite",
    "body": "\\poscite{${1:citekey}}",
    "description": "「著者's (年)」/「著者（年）」に展開される所有格引用"
  },

  "節 (Section)": {
    "scope": "markdown",
    "prefix": "psection",
    "body": "## ${1:1}. ${2:節のタイトル}",
    "description": "番号付き見出し。octavo が {#sec:番号} ラベルを自動で付ける"
  },

  "付録 (Appendix)": {
    "scope": "markdown",
    "prefix": "pappendix",
    "body": "## 付録${1:A}．${2:タイトル}",
    "description": "付録見出し。{#sec:appA} ラベルになる"
  },

  "要旨 (Abstract)": {
    "scope": "markdown",
    "prefix": "pabstract",
    "body": [
      "## 要旨",
      "",
      "${1:ここに要旨を書く。}",
      "",
      "## 1. はじめに",
      "$0"
    ],
    "description": "要旨節（本文から自動で切り離される）"
  },

  "プリント専用ブロック": {
    "scope": "markdown",
    "prefix": "phandout",
    "body": [
      ":::{.handout-only}",
      "${1:プリントにだけ出す内容。}",
      ":::",
      "$0"
    ],
    "description": "handout プロファイル（LaTeX/Typst/Word）のときだけ残る"
  },

  "スライド専用ブロック": {
    "scope": "markdown",
    "prefix": "pslides",
    "body": [
      ":::{.slides-only}",
      "${1:スライドにだけ出す内容。}",
      ":::",
      "$0"
    ],
    "description": "beamer のときだけ残る"
  },

  "発表者ノート": {
    "scope": "markdown",
    "prefix": "pnotes",
    "body": [
      ":::notes",
      "${1:発表者ノート。}",
      ":::",
      "$0"
    ],
    "description": "beamer_notes: true のときだけスライドに刷り込まれる"
  },

  "front matter (題扉)": {
    "scope": "markdown",
    "prefix": "pfrontmatter",
    "body": [
      "---",
      "title: ${1:タイトル}",
      "author: ${2:著者名}",
      "institute: ${3:所属}",
      "date: ${4:2026-01-01}",
      "---",
      "$0"
    ],
    "description": "原稿の先頭に置く YAML front matter"
  }
}

#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""octavo の入口。

    octavo build / watch / checkbib / bib / csl / doctor / init / outline / targets

PATH に通しておくと楽（setup.sh がやる）:
    ln -s ~/octavo/bin/octavo ~/.local/bin/octavo

リポジトリ直下に置けないのは、同じ名前のパッケージ（octavo/）があるから。
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from octavo.cli import main  # noqa: E402

if __name__ == '__main__':
    sys.exit(main())
